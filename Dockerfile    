# ============================================================

# Dockerfile — Wantilan Kriya | HuggingFace Spaces (port 7860)

# ============================================================

FROM python:3.10-slim

# System deps

RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/\*

WORKDIR /app

# Install deps first (layer cache — re-build hanya jika requirements berubah)

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy model artifact (SATU file saja!)

COPY wantilan_pricing_model_v1.joblib .

# Copy app

COPY main.py .

# HuggingFace Spaces wajib port 7860

EXPOSE 7860

HEALTHCHECK --interval=30s --timeout=30s --start-period=120s --retries=3 \
 CMD curl -f http://localhost:7860/ || exit 1

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "7860", "--workers", "1"]
